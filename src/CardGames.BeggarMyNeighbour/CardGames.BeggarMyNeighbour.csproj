<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>Oliver Sanders</Authors>
    <Company />
    <Copyright>Oliver Sanders 2017</Copyright>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageId>CardGames.BeggarMyNeighbour</PackageId>
    <Product>CardGames.BeggarMyNeighbour</Product>
    <Description>Beggar My Neighbour Card Game Library</Description>
    <PackageProjectUrl>https://github.com/oli-sanders/BeggarMyNeighbour</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/oli-sanders/BeggarMyNeighbour</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

</Project>
