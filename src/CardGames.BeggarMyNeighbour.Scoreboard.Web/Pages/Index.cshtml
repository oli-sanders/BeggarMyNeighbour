@page
@model IndexModel
@{
    ViewData["Title"] = "Leaderboard";
}

<h1 class="display-5 mb-3">Beggar My Neighbour — Longest Games</h1>
<p class="text-muted">The top games found so far, ranked by the number of moves (cards played) before the game ended.</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label" for="User">User</label>
        <input class="form-control" type="text" id="User" name="user" value="@Model.UserName" placeholder="any user" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="Strategy">Strategy</label>
        <select class="form-select" id="Strategy" name="Strategy">
            <option value="">any strategy</option>
            @foreach (var strategy in Model.Strategies)
            {
                if (strategy == Model.Strategy)
                {
                    <option value="@strategy" selected>@strategy</option>
                }
                else
                {
                    <option value="@strategy">@strategy</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label" for="Players">Players</label>
        <select class="form-select" id="Players" name="Players">
            <option value="">any</option>
            @foreach (var count in Model.PlayerCounts)
            {
                if (Model.Players == count)
                {
                    <option value="@count" selected>@count</option>
                }
                else
                {
                    <option value="@count">@count</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" href="/">Reset</a>
    </div>
</form>

@if (Model.Scores.Count == 0)
{
    <div class="alert alert-info">
        No scores to show yet. Make sure the Scoreboard API is reachable and that the Compute service has submitted some games.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Score (moves)</th>
                <th scope="col">User</th>
                <th scope="col">Strategy</th>
                <th scope="col">Version</th>
                <th scope="col">Instance</th>
                <th scope="col">Players</th>
                <th scope="col">Verified</th>
            </tr>
        </thead>
        <tbody>
            @{
                var rank = 1;
            }
            @foreach (var score in Model.Scores)
            {
                <tr>
                    <td>@rank</td>
                    <td><strong>@score.Lenght</strong></td>
                    <td>@score.User</td>
                    <td>@score.Strategy</td>
                    <td>@score.Version</td>
                    <td><code class="small">@score.InstanceId</code></td>
                    <td>@score.Players</td>
                    <td>
                        @if (score.IsVerified)
                        {
                            <span class="badge bg-success">verified</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">unverified</span>
                        }
                    </td>
                </tr>
                rank++;
            }
        </tbody>
    </table>
}
